# ─── Vender antes de comprar o al revés? (vente-ou-achat-babbyrodriguez) ─
# Copier vers .env.local et remplir au déploiement.
# Toutes ces valeurs sont propres à CE déploiement/client.

# ─── IA (rapport /analyze) ──────────────────────────────────────────────
# Optionnel — sans clé, l'app utilise le rapport déterministe de repli
# (le verdict, lui, est TOUJOURS calculé par lib/scoring.ts).
ANTHROPIC_API_KEY=

# ─── Webhook CRM (GHL) — /lead ──────────────────────────────────────────
# Sans URL, les leads sont seulement logués côté serveur.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ─── Tracking / analytics (injectés seulement si renseignés) ────────────
# Meta Pixel ID (Advanced Matching hashé côté Meta à la soumission)
NEXT_PUBLIC_META_PIXEL_ID=
# Microsoft Clarity — ID de projet
NEXT_PUBLIC_CLARITY_ID=
# Clarity Scanner — nom de projet (défaut : BRAND.slug de lib/brand.ts)
NEXT_PUBLIC_CLARITY_SCANNER_PROJECT=

# ─── SEO / Open Graph ───────────────────────────────────────────────────
# URL publique du déploiement (metadataBase)
NEXT_PUBLIC_SITE_URL=

# ─── À personnaliser AUSSI (hors .env) ──────────────────────────────────
# lib/brand.ts   → nom, région/ville, textes du hero (espagnol), logos, carte
# lib/regions.ts → liste des villes/secteurs couverts (Rive-Sud de Montréal)
# app/globals.css → palette (bloc @theme) si autre chose que noir/gris/blanc
# public/        → babby-rodriguez-logo.png, remax-platine-logo.png, broker-1.svg
